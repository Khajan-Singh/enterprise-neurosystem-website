# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# playwright mcp output (page snapshots, console logs, screenshots)
/.playwright-mcp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large source deck, kept locally but not tracked (94MB — over GitHub's push limit)
/Enterprise_Neurosystem_Project_Overview_Redesigned.pptx

# AI agent / tooling files — kept locally, never committed
/.claude/
/.codex/
/.impeccable/
/AGENTS.md
/CLAUDE.md
/DESIGN.md
/PRODUCT.md

# internal copy notes (scraped site + deck extract) — kept locally, not published
/content/enterprise-neurosystem-content.md
